{
  "name": "music-player-backend",
  "version": "1.0.0",
  "description": "Music player backend (Hono + Drizzle + Neon)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run build && drizzle-kit generate",
    "db:migrate": "npm run build && drizzle-kit migrate",
    "db:push": "npm run build && drizzle-kit push",
    "db:studio": "npm run build && drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
